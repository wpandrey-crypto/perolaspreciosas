datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  password     String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model CoverMessage {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String?
  content   String
  verse     String?
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model DailyDevotional {
  id          Int      @id @default(autoincrement())
  day         Int      // 1 a 31
  month       Int      // 1 a 12
  title       String
  verse       String
  content     String
  author      String?  @default("Pérolas Preciosas")
  updatedAt   DateTime @updatedAt

  @@unique([month, day])
}

model BibleInOneYear {
  id          Int      @id @default(autoincrement())
  day         Int      // 1 a 31
  month       Int      // 1 a 12
  title       String
  readingPlan String   // Ex: Gênesis 1-3; Mateus 1
  reflection  String?
  updatedAt   DateTime @updatedAt

  @@unique([month, day])
}

model Category {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  parentSlug  String?
  orderIndex  Int       @default(0)
  articles    Article[]
}

model Article {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  summary     String?
  content     String
  author      String?   @default("Leda Latterza")
  views       Int       @default(0)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SiteSection {
  id          Int      @id @default(autoincrement())
  sectionKey  String   @unique // ex: 'diversos-folhetos', 'quem-escreve', 'contato', 'iceb'
  groupName   String   // ex: 'DIVERSOS'
  title       String
  content     String
  updatedAt   DateTime @updatedAt
}

model Occasion {
  id          Int      @id @default(autoincrement())
  month       Int?     // Referência ao mês (ex: 9 - Setembro)
  title       String
  description String?
  content     String?
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}
